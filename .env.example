# =============================================================================
# .env.example  — set these in Vercel → Project → Settings → Environment
# Variables (for local `vercel dev`, copy to .env). SERVER-SIDE only; the
# real values must NEVER appear in frontend code or be committed.
# =============================================================================

# ---- Gmail SMTP credentials (the account that SENDS the notifications) ----
GMAIL_USER=parthadevop@gmail.com

# 16-char Google App Password (NOT your normal Gmail password).
# Google Account → Security → 2-Step Verification → App passwords.
GMAIL_APP_PASSWORD=your-16-char-app-password

# ---- SMTP transport ----
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (recommended) | 465 = SSL
SMTP_PORT=587

# ---- Where YOU receive the submissions (defaults to GMAIL_USER) ----
NOTIFY_TO=parthadevop@gmail.com
