# =============================================================================
# .env.example  — copy to  server/.env  and fill in real values.
# NEVER commit the real .env (it is git-ignored). These are server-side ONLY.
# =============================================================================

# ---- Gmail SMTP credentials ----
# The Gmail account that SENDS the notification emails.
GMAIL_USER=parthadevop@gmail.com

# 16-character Google App Password (NOT your normal Gmail password).
# Create one at: Google Account → Security → 2-Step Verification → App passwords.
# Store the real value as a secret in your host (e.g. GitHub Actions secret,
# Render/Railway/Cloud Run env var). Example format: "abcd efgh ijkl mnop".
GMAIL_APP_PASSWORD=your-16-char-app-password

# ---- SMTP transport ----
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (recommended) | 465 = SSL
SMTP_PORT=587

# ---- Where notifications are delivered (defaults to GMAIL_USER) ----
NOTIFY_TO=parthadevop@gmail.com

# ---- Server ----
PORT=8080

# Comma-separated list of front-end origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000,https://parthanest.github.io
