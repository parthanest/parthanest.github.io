# =============================================================================
# .env.example  — copy to  server/.env  and fill in real values.
# NEVER commit the real .env (git-ignored). These are SERVER-SIDE only.
# =============================================================================

# ---- Gmail SMTP credentials ----
GMAIL_USER=parthadevop@gmail.com

# 16-char Google App Password (NOT your normal Gmail password).
# Google Account → Security → 2-Step Verification → App passwords.
GMAIL_APP_PASSWORD=your-16-char-app-password

# ---- SMTP transport ----
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (recommended) | 465 = SSL
SMTP_PORT=587

# ---- Where notifications land (defaults to GMAIL_USER) ----
NOTIFY_TO=parthadevop@gmail.com

# ---- Server ----
PORT=8080
# Comma-separated front-end origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,https://parthanest.github.io
